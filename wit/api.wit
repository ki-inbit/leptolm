package leptolm:api;

interface models {
    record add-item-req {
        item-name: string,
        quantity: u32,
    }

    record add-item-res {
        success: bool,
        message: string,
        server-time: string,
    }

    record update-item-req {
        id: string,
        quantity: u32,
    }

    record update-item-res {
        success: bool,
        message: string,
    }

    record delete-item-req {
        id: string,
    }

    record delete-item-res {
        success: bool,
        message: string,
    }

    record item {
        id: string,
        item-name: string,
        quantity: u32,
    }

    record get-items-res {
        items: list< item >,
    }
    
    get-items: func() -> get-items-res;

    process-add-item: func(req: add-item-req) -> add-item-res;

    process-update-item: func(req: update-item-req) -> update-item-res;

    process-delete-item: func(req: delete-item-req) -> delete-item-res;
    
}

world shared-types {
    import models;
}

world router {
    import models;
}

world cloudflare-router {
    import models;
    export handle-cloudflare: func(method: string, path: string, body: list< u8 >) -> tuple< u16, string, option< string >, list< u8 > >;
}

// 👑 1. ファサードとRustドライバ間の通信インターフェース (SPI)
interface db-spi {
    // 💡 wasi:sql の型をインポート
    use wasi:sql/types.{row};

    // 💡 戻り値を JSON (string) から list に変更
    query: func(sql: string, params: list< string >) -> result< list< row >, string >;
    exec: func(sql: string, params: list< string >) -> result< u32, string >;
}

// 👑 2. D1(Cloudflare Workers)特有のリプレイ用インターフェース（分離）
interface d1-replay {
    get-cache: func() -> string;
}

world backend {
    export models;
    import wasi:sql/types;
    import wasi:sql/readwrite;
}

world db-facade {
    export wasi:sql/types;
    export wasi:sql/readwrite;
    import db-spi;
}

world driver-d1 {
    export db-spi;
    // 古い定義を消して d1-replay をインポート
    import d1-replay; 
}

world driver-local {
    export db-spi;
}