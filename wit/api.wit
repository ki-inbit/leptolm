package leptolm:api;

interface models {
    record add-item-req {
        item-name: string,
        quantity: u32,
    }

    record add-item-res {
        success: bool,
        message: string,
        server-time: string,
    }

// 👑 1. 新しい型（アイテムの構造体とレスポンス）を追加
    record item {
        id: string,
        item-name: string,
        quantity: u32,
    }

    record get-items-res {
        items: list<item>,
    }
    
    // 👑 2. アイテム一覧取得の関数を定義
    get-items: func() -> get-items-res;

    // 👑 関数をインターフェースの中に定義します
    process-add-item: func(req: add-item-req) -> add-item-res;
}

// 👑 追加: shared クレート専用の世界（リンカーのバグ回避用）
world shared-types {
    import models;
}

// 👑 Rust(ルーター)用の世界：APIを「呼び出す（import）」側
world router {
    import models;
}

// 👑 MoonBit(バックエンド)用の世界：APIを「提供する（export）」側
world backend {
    export models;
}

// 👑 Cloudflare専用の世界を新設！ WASIの呪縛を完全に断ち切ります
world cloudflare-router {
    import models;
    export handle-cloudflare: func(method: string, path: string, body: list<u8>) -> tuple<u16, string, option<string>, list<u8>>;
}